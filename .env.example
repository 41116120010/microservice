# Required to create the initial admin account in auth-service.
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required only when the konsumer service is enabled.
MAIL_USERNAME=your-gmail-address@example.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_TO=recipient@example.com
